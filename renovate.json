{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "bun"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpgradeTasks": {
    "commands": [
      "bun install"
    ],
    "executionMode": "branch"
  },
  "constraints": {
    "bun": "1.x"
  }
}