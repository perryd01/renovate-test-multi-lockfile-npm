{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
        "matchManagers": ["yarn"],
        "enabled": false
    },
    {
        "matchManagers": ["bun"],
        "enabled": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}